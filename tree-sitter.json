{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tree_sitter_flix",
      "camelcase": "TreeSitterFlix",
      "title": "TreeSitterFlix",
      "scope": "source.tree_sitter_flix",
      "file-types": [
        "tree_sitter_flix"
      ],
      "injection-regex": "^tree_sitter_flix$",
      "class-name": "TreeSitterTreeSitterFlix"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Tree sitter parser for the Flix language",
    "authors": [],
    "links": {
      "repository": "https://github.com/herluf-ba/tree-sitter-flix"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
